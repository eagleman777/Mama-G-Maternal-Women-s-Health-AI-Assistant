# ==========================================
# Mama-G Environment Configuration Example
# ==========================================
# Copy this file to .env and adjust values for local development.
# Note: Core ONNX runtime and clinical triage run 100% locally and offline without required API keys.

# Application Environment & Runtime
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Algorand Node Endpoint (Defaults to public testnet/local fallback)
NEXT_PUBLIC_ALGORAND_NODE_URL=https://testnet-api.algorand.network

# Optional Analytics or Logging (Leave blank for offline/local mode)
NEXT_PUBLIC_ENABLE_OFFLINE_LOGGING=false

# ==========================================
# AI Studio / Cloud Run Runtime Secrets
# ==========================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# Regional Midwife Emergency Escalation (Infobip REST API)
# ==========================================
# Target Regional Hub: https://hub.mamag-health.org
# Edge Node Repository: https://github.com/mamag/edge-node
# Configure real Infobip credentials (or copy .env.infobip.example to .env.infobip)
# to dispatch live Level-1 obstetric emergency SMS alerts via /sms/2/text/advanced.
# Set ALERT_DRY_RUN=true to log payloads safely without making live HTTP calls.
MAMAG_HUB_URL="https://hub.mamag-health.org"
MAMAG_EDGE_REPO="https://github.com/mamag/edge-node"
INFOBIP_BASE_URL="<your-subdomain>.api.infobip.com"
INFOBIP_API_KEY="<your-infobip-api-key>"
INFOBIP_SMS_FROM="<registered-phone-digits-without-plus>"
INFOBIP_TEST_TO="<verified-test-recipient-digits-without-plus>"
MIDWIFE_ONCALL_UYO=""
MIDWIFE_ONCALL_IBENO=""
MIDWIFE_ONCALL_MBO=""
ALERT_DRY_RUN="false"
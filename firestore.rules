rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_-]+$') && id.size() > 0 && id.size() <= 128;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'role', 'preferredLanguage', 'gestationWeeks', 'lastPeriodDate', 'cycleLength', 'periodDuration', 'cycleAlertEnabled', 'cycleNotes', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 150
        && data.role in ['mother', 'postpartum', 'adolescent', 'chw']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('preferredLanguage' in data) || (data.preferredLanguage in ['English', 'Nigerian Pidgin', 'Swahili', 'French', 'Hausa', 'Yoruba']))
        && (!('gestationWeeks' in data) || (data.gestationWeeks is number && data.gestationWeeks >= 1 && data.gestationWeeks <= 45))
        && (!('lastPeriodDate' in data) || (data.lastPeriodDate is string && data.lastPeriodDate.size() <= 30))
        && (!('cycleLength' in data) || (data.cycleLength is number && data.cycleLength >= 18 && data.cycleLength <= 60))
        && (!('periodDuration' in data) || (data.periodDuration is number && data.periodDuration >= 1 && data.periodDuration <= 15))
        && (!('cycleAlertEnabled' in data) || data.cycleAlertEnabled is bool)
        && (!('cycleNotes' in data) || (data.cycleNotes is string && data.cycleNotes.size() <= 500))
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidNote(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content', 'severity', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'content', 'severity', 'createdAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.id is string
        && data.id.matches('^[a-zA-Z0-9_-]+$')
        && data.id.size() <= 128
        && data.title is string
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() <= 5000
        && data.severity in ['ROUTINE', 'URGENT', 'EMERGENCY']
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidGameScore(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'score', 'mothersHelped', 'kitsDelivered', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'score', 'mothersHelped', 'kitsDelivered', 'distance', 'createdAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.id is string
        && data.id.matches('^[a-zA-Z0-9_-]+$')
        && data.id.size() <= 128
        && data.score is number && data.score >= 0
        && data.mothersHelped is number && data.mothersHelped >= 0
        && data.kitsDelivered is number && data.kitsDelivered >= 0
        && (!('distance' in data) || (data.distance is number && data.distance >= 0))
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'role', 'preferredLanguage', 'gestationWeeks', 'lastPeriodDate', 'cycleLength', 'periodDuration', 'cycleAlertEnabled', 'cycleNotes', 'updatedAt'])
                    && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId)
                      && isValidId(userId)
                      && isValidId(noteId)
                      && request.resource.data.id == noteId
                      && isValidNote(request.resource.data, userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      }

      match /gameScores/{scoreId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(scoreId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId)
                      && isValidId(userId)
                      && isValidId(scoreId)
                      && request.resource.data.id == scoreId
                      && isValidGameScore(request.resource.data, userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(scoreId);
      }
    }
  }
}

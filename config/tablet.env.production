# ==============================================================================
# Mama-G Field Tablet Operational Configuration (Non-Sensitive Public Tier)
# Safe for plain-text storage on edge tablet flash; NO API keys or tokens here.
# ==============================================================================
MAMA_G_ENV=production
MAMA_G_DEPLOYMENT_STATE=Akwa Ibom
MAMA_G_DEFAULT_LGA=Ibeno
MAMA_G_LANGUAGE_MODE=ibb
MAMA_G_SYNC_BATCH_SIZE=50
MAMA_G_SYNC_INTERVAL_SEC=120
MAMA_G_CLIMATE_MODULE_ENABLED=true
MAMA_G_SQLITE_WAL_MODE=true
